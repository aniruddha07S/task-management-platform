            "description": "Required: title, dueDate, assignedUser. Saves the new id to `taskId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare sprint demo\",\n  \"description\": \"Slides + live walkthrough\",\n  \"priority\": \"High\",\n  \"dueDate\": \"2026-10-15\",\n  \"status\": \"Pending\",\n  \"assignedUser\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('taskId', json._id);",
                  "pm.test('Task has id', () => pm.expect(json._id).to.be.a('string'));"
